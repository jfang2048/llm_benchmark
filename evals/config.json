{
  "schema_version": "1",
  "note": "Capability-evaluation configuration. Model metadata lives in configs/models.json (single source of truth); this file only pins external benchmark versions, the agent serving profile, and deterministic subset specs.",

  "cache_dir": ".cache/evals",

  "agent_profile": {
    "note": "Serving profile for coding-agent workloads. Distinct from the serving benchmark (ctx 4096 / parallel 2): agent trajectories are evaluated one at a time and need more context.",
    "ctx_size": 8192,
    "parallel": 1,
    "cont_batching": true,
    "n_gpu_layers": 999,
    "kv_cache_policy": "none",
    "kv_cache_policy_note": "No KV-cache quantization used for the primary comparison. Recorded per run in the manifest if changed.",
    "context_ladder": [8192, 12288, 16384],
    "common_agent_context": 8192,
    "generation": { "temperature": 0.3, "n": 1 }
  },

  "direct_coding_profile": {
    "ctx_size": 8192,
    "parallel": 1,
    "n_gpu_layers": 999,
    "generation": { "temperature": 0, "n": 1 }
  },

  "benchmarks": {
    "evalplus": {
      "repo": "https://github.com/evalplus/evalplus.git",
      "version": "v0.3.1",
      "commit": "26d6d00bb1fd0fa37f39c99d5290da67891d1c5e",
      "harness": "evalplus",
      "datasets": ["humaneval", "mbpp"],
      "protocol": "temp=0, n=1, official EvalPlus executor"
    },
    "livecodebench": {
      "repo": "https://github.com/LiveCodeBench/LiveCodeBench.git",
      "version": "main",
      "commit": "28fef95ea8c9f7a547c8329f2cd3d32b92c1fa24",
      "harness": "lcb_runner",
      "scenarios": ["code_generation"],
      "note": "LOCAL PROTOCOL: lite code-generation path, n=1. Not leaderboard-equivalent."
    },
    "swe_verified": {
      "repo": "https://github.com/SWE-bench/SWE-bench.git",
      "version": "main",
      "commit": "02e7a74ffd0b707aab73d203fe87bdc7c76afc8e",
      "harness": "swebench official",
      "agent": "mini-swe-agent",
      "subset": { "name": "SWE-bench Verified Local-20", "seed": 42, "size": 20 }
    },
    "deepswe": {
      "repo": "https://github.com/datacurve-ai/deep-swe.git",
