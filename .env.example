# =====================================================================
# Environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# =====================================================================

# --- Model identifiers ---
# Qwen3-4B GGUF (downloaded by scripts/download_models.sh)
QWEN_GGUF_REPO=Qwen/Qwen3-4B-GGUF
QWEN_GGUF_FILE=Qwen3-4B-Q4_K_M.gguf

# Spark-X2.5-4B base model (weights are not auto-downloaded; see models/README.md)
SPARK_BASE_REPO=XHToken/Spark-X2.5-4B

# --- vLLM deployment (optional secondary backend) ---
# Hugging Face token, ONLY needed if a model is gated. Leave empty otherwise.
HF_TOKEN=

# vLLM host-side port (container listens on 8000 internally).
VLLM_HOST_PORT=8001

# vLLM OpenAI-compatible API key. Generate your own:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
VLLM_API_KEY=

# Required for the vLLM V2 model runner on WSL2.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# --- Observability stack (Grafana admin) ---
GRAFANA_ADMIN_PASSWORD=
