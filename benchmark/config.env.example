# Benchmark configuration template.
# Copy to config.env and adjust if needed; scripts source it if present.
#   cp benchmark/config.env.example benchmark/config.env
# config.env is git-ignored (matches .env.*).

# --- Models (filenames under models/) ---
QWEN_GGUF_FILE=Qwen3-4B-Q4_K_M.gguf
SPARK_GGUF_FILE=Spark-X2.5-4B-Q4_K_M.gguf
QWEN_GGUF_REPO=Qwen/Qwen3-4B-GGUF

# --- Serving images ---
LLAMA_IMAGE=spark-x25-llama:cuda13
VLLM_BASE_IMAGE=vllm/vllm-openai:v0.26.0
VLLM_GGUF_IMAGE=vllm-openai-gguf:v0.26.0
VLLM_GGUF_PLUGIN_VERSION=0.0.4

# --- Runtime controls (llama.cpp) ---
# Per-request context (ISL 2048 + OSL 128 + chat-template margin = 2304).
PER_REQUEST_CTX=2304
MAX_CONCURRENCY=4
# llama.cpp --ctx-size is TOTAL context shared by --parallel slots.
# Set explicitly by scripts/deploy.sh as PER_REQUEST_CTX * MAX_CONCURRENCY.

# --- vLLM runtime controls ---
GPU_MEM_UTIL=0.80
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# --- Benchmark parameters (override the defaults baked into scripts/benchmark.sh) ---
# MODE=final|smoke
# REQUESTS=80
# WARMUP=5
# REPEATS=4
# CONCURRENCIES="1 2 3 4"
# OUTPUT_TOKENS=128
# SEED=42
# MAX_ERROR_RATE=1.0
# STARTUP_TIMEOUT=180
# COOLDOWN_SECONDS=5
# REQUEST_TIMEOUT=180
# CELL_TIMEOUT=900

# --- Model hashes (pinned; used by scripts/download_models.sh for verification) ---
QWEN_GGUF_SHA256=7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5
SPARK_GGUF_SHA256=7934660bfc5b9bf04be0a0ac6179a1d16e1d4331b448857c86b8b2801b3ef72c
